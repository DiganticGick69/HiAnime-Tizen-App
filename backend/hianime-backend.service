# systemd unit to keep the backend running on a PC / Raspberry Pi.
# Edit the paths and User, then:
#   sudo cp backend/hianime-backend.service /etc/systemd/system/
#   sudo systemctl enable --now hianime-backend
[Unit]
Description=HiAnime TV backend
After=network-online.target
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/path/to/HiAnime-Tizen-App/backend
ExecStart=/path/to/HiAnime-Tizen-App/.venv/bin/python -m hianime_backend
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
