<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://github.com/hianime-tizen-app"
        version="1.0.0"
        viewmodes="maximized">
    <tizen:application id="HiAnimeTV0.HiAnimeTV" package="HiAnimeTV0" required_version="5.0"/>
    <name>HiAnime</name>
    <description>Browse, search and watch anime from HiAnime with a TV-friendly interface.</description>
    <author>HiAnime Tizen App</author>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <!-- Subtitles are downloaded with the Referer their host requires, then read back. -->
    <tizen:privilege name="http://tizen.org/privilege/download"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <!-- The app reads the site's API, its mirror pages, the episode embed page (HTML only),
         artwork and the video host. Mirror domains change, so access isn't pinned to hosts.
         There's no allow-navigation: the app never leaves its own page. -->
    <access origin="*" subdomains="true"/>
</widget>
