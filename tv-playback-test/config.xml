<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://github.com/hianime-tizen-app/playback-test"
        version="1.0.0"
        viewmodes="maximized">
    <tizen:application id="HiAnimeTst.PlaybackTest" package="HiAnimeTst" required_version="5.0"/>
    <name>HiAnime Test</name>
    <description>Checks which video playback method works on this TV.</description>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>zokoanime.video megaplay.buzz megaplay-1.buzz</tizen:allow-navigation>
</widget>
